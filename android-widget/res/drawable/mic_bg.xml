<?xml version="1.0" encoding="utf-8"?>
<!-- 語音輸入大方塊（2026-11-04）：按下去顏色深一點 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5A3A1C2E" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#88FF4D5E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E9DF3FF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#339DF3FF" />
        </shape>
    </item>
</selector>
